	f	I	NOTIFY_NEIGHBORS	l	field_31027
		c	Sends a neighbor update event to surrounding blocks.
	f	I	NOTIFY_LISTENERS	m	field_31028
		c	Notifies listeners and clients who need to react when the block changes.
	f	I	NO_REDRAW	n	field_31029
		c	Used in conjunction with {@link #NOTIFY_LISTENERS} to suppress the render pass on clients.
	f	I	REDRAW_ON_MAIN_THREAD	o	field_31030
		c	Forces a synchronous redraw on clients.
	f	I	FORCE_STATE	p	field_31031
		c	Bypass virtual block state changes and forces the passed state to be stored as-is.
	f	I	SKIP_DROPS	q	field_31032
		c	Prevents the previous block (container) from dropping items when destroyed.
	f	I	MOVED	r	field_31033
		c	Signals that the current block is being moved to a different location, usually because of a piston.
	f	I	SKIP_REDSTONE_WIRE_STATE_REPLACEMENT	s	field_53822
		c	Skips {@link AbstractBlock#getStateForNeighborUpdate} call for redstone wire.
	f	I	SKIP_BLOCK_ENTITY_REPLACED_CALLBACK	t	field_55739
		c	Skips {@link BlockEntity#onBlockReplaced}.\nUsed when placing structures.
	f	I	SKIP_BLOCK_ADDED_CALLBACK	u	field_56561
		c	Skips {@link AbstractBlock#onBlockAdded}.\nUsed when placing structures.
	f	I	SKIP_REDRAW_AND_BLOCK_ENTITY_REPLACED_CALLBACK	v	field_31035
		c	@see #NO_REDRAW\n@see #SKIP_BLOCK_ENTITY_REPLACED_CALLBACK
	f	I	NOTIFY_ALL	w	field_31036
		c	The default setBlockState behavior. Same as {@code NOTIFY_NEIGHBORS | NOTIFY_LISTENERS}.
	f	I	NOTIFY_ALL_AND_REDRAW	x	field_31022
		c	Notifies neighbors and listeners, and forces a redraw on clients. Same as {@code NOTIFY_ALL | REDRAW_ON_MAIN_THREAD}
	f	I	FORCE_STATE_AND_SKIP_CALLBACKS_AND_DROPS	y	field_55740
